{
  "name": "Penghua Zhou Portfolio Design System",
  "version": "1.0.0",
  "description": "Bold minimalist design system extracted from index.html — inspired by Portez & Modio",

  "color": {
    "background": {
      "base": "#ffffff",
      "surface": "#f5f5f5",
      "elevated": "#eaeaea",
      "border": "#e0e0e0"
    },
    "text": {
      "primary": "#000000",
      "secondary": "#616161",
      "tertiary": "#8f8f8f",
      "inverse": "#ffffff"
    },
    "accent": {
      "primary": "#000000",
      "light": "rgba(0, 0, 0, 0.05)",
      "hover-green": "#4a7c59",
      "nav-dot": "#ff3b30",
      "particle-green": "rgba(74,124,89,0.3)"
    },
    "overlay": {
      "card-hover": "linear-gradient(to top, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.45) 30%, rgba(0,0,0,0) 60%)",
      "nav-glass": "rgba(255,255,255,0.9)"
    }
  },

  "typography": {
    "fontFamily": {
      "sans": "'Inter', -apple-system, BlinkMacSystemFont, sans-serif"
    },
    "fontWeight": {
      "light": 300,
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem",
      "hero": "clamp(3.5rem, 8vw, 6rem)"
    },
    "lineHeight": {
      "tight": 1,
      "snug": 1.2,
      "normal": 1.5,
      "relaxed": 1.6,
      "loose": 1.8
    },
    "letterSpacing": {
      "tight": "-0.04em",
      "compact": "-0.03em",
      "snug": "-0.02em",
      "normal": "0",
      "wide": "0.03em",
      "wider": "0.08em"
    }
  },

  "spacing": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px"
  },

  "layout": {
    "maxWidth": "1200px",
    "containerPadding": {
      "desktop": "40px",
      "mobile": "20px"
    },
    "sectionPadding": {
      "desktop": "96px",
      "mobile": "64px"
    },
    "navHeight": "60px"
  },

  "radius": {
    "none": "0",
    "sm": "4px",
    "full": "9999px"
  },

  "shadow": {
    "sm": "0 1px 3px rgba(0,0,0,0.06)",
    "md": "0 4px 20px rgba(0,0,0,0.08)",
    "lg": "0 16px 48px rgba(0,0,0,0.1)"
  },

  "motion": {
    "duration": {
      "fast": "200ms",
      "normal": "300ms",
      "slow": "500ms",
      "reveal": "700ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.16, 1, 0.3, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "smooth": "ease"
    }
  },

  "breakpoints": {
    "mobile": "480px",
    "tablet": "768px",
    "desktop": "900px",
    "wide": "1200px"
  },

  "opacity": {
    "muted": 0.3,
    "subtle": 0.5,
    "strong": 0.7
  }
}
